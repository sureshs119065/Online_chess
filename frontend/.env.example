# Leave both unset for local dev - vite.config.ts's proxy forwards /api and
# /ws straight to the gateway on localhost:8080, no CORS setup needed.
#
# Set both once you deploy this frontend (e.g. to Vercel) and point them at
# your deployed api-gateway. Remember to also add this frontend's deployed
# URL to api-gateway's FRONTEND_ORIGIN env var on the backend, or the
# browser will block every request with a CORS error.
# VITE_API_BASE_URL=https://your-gateway.onrender.com
# VITE_WS_BASE_URL=wss://your-gateway.onrender.com
