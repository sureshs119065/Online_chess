# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database (plain PostgreSQL - local install for dev, Render's free
# Postgres once deployed) ---
# Local dev: install Postgres natively, create a database named
# chess_platform, and set the password you chose during install below.
# DB_HOST/DB_PORT/DB_NAME/DB_USER all have sensible localhost defaults in
# every service's application.yml, so DB_PASSWORD is usually the only one
# you actually need to set here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chess_platform
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password_here

JWT_SECRET=change_this_to_a_long_random_string_at_least_32_characters
INTERNAL_SERVICE_KEY=change_this_to_another_long_random_string

# RabbitMQ (Session 7) - recommended: CloudAMQP free tier (no Docker, no
# local install). Create a free "Little Lemur" instance at cloudamqp.com,
# then copy the individual connection fields from its dashboard (NOT the
# single amqp:// URL - decompose it into the pieces below).
RABBITMQ_HOST=your-instance.rmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=your_cloudamqp_username
RABBITMQ_PASSWORD=your_cloudamqp_password
RABBITMQ_VHOST=your_cloudamqp_vhost
RABBITMQ_SSL_ENABLED=true

# api-gateway (Session 8) - optional override, default works for local dev
# FRONTEND_ORIGIN=https://your-deployed-frontend.example.com
